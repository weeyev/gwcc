# All paths default to repository directories. Override with absolute paths if needed.
# GEOCAST_SAMPLE_DIR=/absolute/path/to/data/samples
# GEOCAST_ARTIFACT_DIR=/absolute/path/to/artifacts
# GEOCAST_CACHE_DIR=/absolute/path/to/data/cache
# GEOCAST_FRONTEND_DIR=/absolute/path/to/frontend

# Only needed for the optional Earth Engine extraction script.
# GEOCAST_EE_PROJECT=your-google-cloud-project
